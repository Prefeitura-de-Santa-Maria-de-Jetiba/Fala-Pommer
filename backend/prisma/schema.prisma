  cadastro_rebaixamentos_comunidades_rebaixado_porTocadastro    cadastro   @relation("rebaixamentos_comunidades_rebaixado_porTocadastro", fields: [rebaixado_por], references: [id], onUpdate: Restrict, map: "fk_rc_rebaixado_por")

  @@index([comunidade_id], map: "fk_rc_comunidade_id")
  @@index([pessoa_rebaixada], map: "fk_rc_pessoa_rebaixada")
  @@index([rebaixado_por], map: "fk_rc_rebaixado_por")
