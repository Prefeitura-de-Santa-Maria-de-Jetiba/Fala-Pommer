generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model cadastro {
  id                                                                             Int                         @id @default(autoincrement())
  nome                                                                           String                      @db.VarChar(150)
  data_nascimento                                                                DateTime                    @db.Date
  cpf                                                                            String                      @db.VarChar(20)
  telefone                                                                       String                      @db.VarChar(20)
  email                                                                          String                      @db.VarChar(150)
  senha                                                                          String                      @db.VarChar(255)
  token_recuperacao                                                              String?                     @db.VarChar(64)
  token_recuperacao_expira_em                                                    DateTime?
  tipo_usuario                                                                   cadastro_tipo_usuario       @default(user)
  setor_id                                                                       Int?
  foto_perfil_url                                                                String?                     @db.VarChar(500)
  dois_fatores_email_ativo                                                       Boolean                     @default(false)
  dois_fatores_email_confirmado_em                                               DateTime?
  secretaria_id                                                                  Int?
  desativado_em                                                                  DateTime?
  desativado_por                                                                 Int?
  motivo_desativacao                                                             String?                     @db.VarChar(500)
  versao_token                                                                   Int                         @default(0) @db.UnsignedInt
  avaliacoes_realizadas                                                          avaliacao[]                 @relation("AvaliadorAvaliacao")
  responsavel_desativacao                                                        cadastro?                   @relation("CadastroDesativadoPor", fields: [desativado_por], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cadastro_desativado_por")
  desativacoes_realizadas                                                        cadastro[]                  @relation("CadastroDesativadoPor")
  secretaria                                                                     secretaria?                 @relation(fields: [secretaria_id], references: [id], onUpdate: Restrict, map: "fk_cadastro_secretaria")
  setor                                                                          setores?                    @relation(fields: [setor_id], references: [id], onUpdate: Restrict, map: "fk_cadastro_setor")
  codigo_recuperacao_2fa                                                         codigo_recuperacao_2fa[]
  comunidades_criadas                                                            comunidade[]
  comunidade_usuarios                                                            comunidade_usuarios[]
  finalizacoes_realizadas                                                        conversa_finalizacao[]      @relation("ResponsavelFinalizacao")
  conversa_leitura                                                               conversa_leitura[]
  conversa_participante                                                          conversa_participante[]
  conversas_atendidas                                                            conversa_setor[]            @relation("UsuarioAtendido")
  conversa_transferencia                                                         conversa_transferencia[]
  convite_comunidade                                                             convite_comunidade[]
  desafio_login_2fa                                                              desafio_login_2fa[]
  erro_autenticacao                                                              erro_autenticacao[]
  historicos_como_administrador                                                  historico_administrativo[]  @relation("HistoricoAdministrador")
  historicos_como_usuario_alvo                                                   historico_administrativo[]  @relation("HistoricoUsuarioAlvo")
  login_evento                                                                   login_evento[]
  mensagens_enviadas                                                             mensagem[]                  @relation("RemetenteMensagem")
  promocoes_comunidades_promocoes_comunidades_pessoa_promovidaTocadastro         promocoes_comunidades[]     @relation("promocoes_comunidades_pessoa_promovidaTocadastro")
  promocoes_comunidades_promocoes_comunidades_promovido_porTocadastro            promocoes_comunidades[]     @relation("promocoes_comunidades_promovido_porTocadastro")
  rebaixamentos_comunidades_rebaixamentos_comunidades_pessoa_rebaixadaTocadastro rebaixamentos_comunidades[] @relation("rebaixamentos_comunidades_pessoa_rebaixadaTocadastro")
  rebaixamentos_comunidades_rebaixamentos_comunidades_rebaixado_porTocadastro    rebaixamentos_comunidades[] @relation("rebaixamentos_comunidades_rebaixado_porTocadastro")
  sessoes                                                                        sessao[]
  tokens_push                                                                    token_push[]

  @@index([setor_id], map: "fk_cadastro_setor")
  @@index([secretaria_id], map: "fk_cadastro_secretaria")
  @@index([desativado_em, id], map: "idx_cadastro_status_id")
  @@index([desativado_por], map: "idx_cadastro_desativado_por")
}

model sessao {
  id                 String       @id @default(cuid())
  usuario_id         Int
  refresh_token_hash String       @unique(map: "uq_sessao_refresh_token_hash") @db.Char(64)
  nome_dispositivo   String?      @db.VarChar(150)
  plataforma         String?      @db.VarChar(30)
  ultimo_uso_em      DateTime     @default(now()) @db.DateTime(0)
  revogada_em        DateTime?    @db.DateTime(0)
  criado_em          DateTime     @default(now()) @db.DateTime(0)
  versao_token       Int          @db.UnsignedInt
  usuario            cadastro     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_sessao_usuario")
  tokens_push        token_push[]

  @@index([usuario_id], map: "idx_sessao_usuario")
}

model token_push {
  id            Int      @id @default(autoincrement())
  token         String   @unique(map: "uq_token_push_token") @db.VarChar(512)
  usuario_id    Int
  sessao_id     String
  plataforma    String   @db.VarChar(20)
  criado_em     DateTime @default(now()) @db.DateTime(0)
  atualizado_em DateTime @updatedAt @db.DateTime(0)
  sessao        sessao   @relation(fields: [sessao_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_token_push_sessao")
  usuario       cadastro @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_token_push_usuario")

  @@index([usuario_id], map: "idx_token_push_usuario")
  @@index([sessao_id], map: "idx_token_push_sessao")
}

model erro_autenticacao {
  id         Int                    @id @default(autoincrement())
  usuario_id Int
  tipo       erro_autenticacao_tipo
  criado_em  DateTime               @default(now()) @db.DateTime(0)
  cadastro   cadastro               @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_erro_autenticacao_usuario")

  @@index([usuario_id], map: "idx_erro_autenticacao_usuario")
  @@index([criado_em], map: "idx_erro_autenticacao_criado_em")
}

model login_evento {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  criado_em  DateTime  @default(now()) @db.DateTime(0)
  saiu_em    DateTime? @db.DateTime(0)
  cadastro   cadastro  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_login_evento_usuario")

  @@index([usuario_id], map: "fk_login_evento_usuario")
  @@index([criado_em], map: "idx_login_evento_criado_em")
}

model conversa {
  id                     Int                      @id @default(autoincrement())
  tipo                   conversa_tipo            @default(privada)
  nome                   String?                  @db.VarChar(120)
  criada_em              DateTime                 @default(now()) @db.DateTime(0)
  comunidade             comunidade?
  finalizacoes           conversa_finalizacao[]
  conversa_leitura       conversa_leitura[]
  conversa_participante  conversa_participante[]
  atendimento_setor      conversa_setor?
  conversa_transferencia conversa_transferencia[]
  mensagens              mensagem[]
}

model conversa_participante {
  conversa_id               Int
  usuario_id                Int
  entrou_em                 DateTime  @default(now()) @db.DateTime(0)
  ocultada_em               DateTime?
  visivel_desde_mensagem_id Int?
  conversa                  conversa  @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_participante_conversa")
  cadastro                  cadastro  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_participante_usuario")

  @@id([conversa_id, usuario_id])
  @@index([usuario_id, ocultada_em], map: "idx_participante_usuario_visibilidade")
}

model conversa_setor {
  conversa_id                       Int       @id
  setor_id                          Int
  usuario_id                        Int
  criada_em                         DateTime  @default(now()) @db.DateTime(0)
  ocultada_para_usuario_em          DateTime?
  usuario_visivel_desde_mensagem_id Int?
  conversa                          conversa  @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_conversa_setor_conversa")
  setor                             setores   @relation(fields: [setor_id], references: [id], onUpdate: Restrict, map: "fk_conversa_setor_setor")
  usuario                           cadastro  @relation("UsuarioAtendido", fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_conversa_setor_usuario")

  @@index([setor_id, usuario_id, ocultada_para_usuario_em], map: "idx_conversa_setor_usuario_visibilidade")
  @@index([usuario_id], map: "idx_conversa_setor_usuario")
  @@index([usuario_visivel_desde_mensagem_id], map: "idx_conversa_setor_inicio_visibilidade_usuario")
}

model mensagem {
  id                     Int                     @id @default(autoincrement())
  conversa_id            Int
  remetente_id           Int
  origem                 mensagem_origem
  sistema                Boolean                 @default(false)
  visibilidade           mensagem_visibilidade   @default(todos)
  transferencia_id       Int?
  setor_id               Int?
  mensagem_respondida_id Int?
  conteudo               String                  @db.Text
  enviada_em             DateTime                @default(now()) @db.DateTime(0)
  arquivo_nome           String?                 @db.VarChar(255)
  arquivo_url            String?                 @db.VarChar(500)
  arquivo_tipo           String?                 @db.VarChar(20)
  arquivo_mime           String?                 @db.VarChar(150)
  arquivo_tamanho        Int?
  finalizacoes           conversa_finalizacao[]  @relation("MensagemFinalizacao")
  conversa_leitura       conversa_leitura[]
  conversa               conversa                @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_mensagem_conversa")
  remetente              cadastro                @relation("RemetenteMensagem", fields: [remetente_id], references: [id], onUpdate: Restrict, map: "fk_mensagem_remetente")
  mensagem_respondida    mensagem?               @relation("RespostaMensagem", fields: [mensagem_respondida_id], references: [id], onUpdate: Restrict, map: "fk_mensagem_respondida")
  respostas              mensagem[]              @relation("RespostaMensagem")
  setores                setores?                @relation(fields: [setor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_mensagem_setor")
  conversa_transferencia conversa_transferencia? @relation(fields: [transferencia_id], references: [id], onUpdate: Restrict, map: "fk_mensagem_transferencia")

  @@index([conversa_id, enviada_em], map: "idx_mensagem_conversa_data")
  @@index([remetente_id], map: "idx_mensagem_remetente")
  @@index([conversa_id, id], map: "idx_mensagem_conversa_id")
  @@index([conversa_id, visibilidade, id], map: "idx_mensagem_conversa_visibilidade_id")
  @@index([setor_id], map: "idx_mensagem_setor")
  @@index([transferencia_id], map: "idx_mensagem_transferencia")
  @@index([mensagem_respondida_id], map: "idx_mensagem_respondida")
}

model setores {
  id                                                                      Int                      @id @default(autoincrement())
  setor                                                                   String                   @db.VarChar(150)
  sigla_setor                                                             String                   @db.VarChar(20)
  secretaria_id                                                           Int?
  cadastros                                                               cadastro[]
  atendimentos                                                            conversa_setor[]
  conversa_transferencia_conversa_transferencia_setor_destino_idTosetores conversa_transferencia[] @relation("conversa_transferencia_setor_destino_idTosetores")
  conversa_transferencia_conversa_transferencia_setor_origem_idTosetores  conversa_transferencia[] @relation("conversa_transferencia_setor_origem_idTosetores")
  mensagem                                                                mensagem[]
  secretaria                                                              secretaria?              @relation(fields: [secretaria_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_setores_secretaria")

  @@index([secretaria_id], map: "idx_setores_secretaria_id")
}

model conversa_leitura {
  conversa_id             Int
  usuario_id              Int
  ultima_mensagem_lida_id Int?
  lida_em                 DateTime  @default(now()) @db.DateTime(0)
  conversa                conversa  @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_conversa_leitura_conversa")
  mensagem                mensagem? @relation(fields: [ultima_mensagem_lida_id], references: [id], onUpdate: Restrict, map: "fk_conversa_leitura_ultima_mensagem")
  cadastro                cadastro  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_conversa_leitura_usuario")

  @@id([conversa_id, usuario_id])
  @@index([ultima_mensagem_lida_id], map: "idx_conversa_leitura_ultima_mensagem")
  @@index([usuario_id], map: "idx_conversa_leitura_usuario")
}

model codigo_recuperacao_2fa {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  codigo_hash String    @db.VarChar(255)
  usado_em    DateTime?
  criado_em   DateTime  @default(now())
  cadastro    cadastro  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_codigo_recuperacao_2fa_usuario")

  @@index([usuario_id, usado_em], map: "idx_codigo_recuperacao_disponivel")
  @@index([usuario_id], map: "idx_codigo_recuperacao_usuario")
}

model desafio_login_2fa {
  id              Int                    @id @default(autoincrement())
  usuario_id      Int
  finalidade      desafio_2fa_finalidade @default(login)
  token_hash      String                 @unique(map: "uq_desafio_login_token") @db.Char(64)
  codigo_hash     String                 @db.VarChar(255)
  tentativas      Int                    @default(0) @db.UnsignedTinyInt
  reenvios        Int                    @default(0) @db.UnsignedTinyInt
  expira_em       DateTime
  usado_em        DateTime?
  criado_em       DateTime               @default(now())
  ultimo_envio_em DateTime               @default(now())
  cadastro        cadastro               @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_desafio_login_2fa_usuario")

  @@index([expira_em], map: "idx_desafio_login_expiracao")
  @@index([usuario_id], map: "idx_desafio_login_usuario")
  @@index([usuario_id, finalidade, criado_em], map: "idx_desafio_2fa_limite")
}

model secretaria {
  id               Int        @id @default(autoincrement())
  secretaria       String     @db.VarChar(150)
  sigla_secretaria String     @db.VarChar(100)
  cadastros        cadastro[]
  setores          setores[]
}

model historico_administrativo {
  id                     Int                           @id @default(autoincrement())
  administrador_id       Int
  usuario_alvo_id        Int
  acao                   historico_administrativo_acao
  motivo                 String?                       @db.VarChar(500)
  criado_em              DateTime                      @default(now())
  tipo_usuario_anterior  cadastro_tipo_usuario?
  setor_id_anterior      Int?
  secretaria_id_anterior Int?
  administrador          cadastro                      @relation("HistoricoAdministrador", fields: [administrador_id], references: [id], onUpdate: Restrict, map: "fk_historico_administrador")
  usuario_alvo           cadastro                      @relation("HistoricoUsuarioAlvo", fields: [usuario_alvo_id], references: [id], onUpdate: Restrict, map: "fk_historico_usuario_alvo")

  @@index([administrador_id, criado_em], map: "idx_historico_administrador_data")
  @@index([usuario_alvo_id, criado_em], map: "idx_historico_usuario_data")
}

model avaliacao {
  id             Int                  @id @default(autoincrement())
  nota           Int
  descricao      String?              @db.VarChar(500)
  avaliador_id   Int
  criada_em      DateTime             @default(now()) @db.DateTime(0)
  finalizacao_id Int
  avaliador      cadastro             @relation("AvaliadorAvaliacao", fields: [avaliador_id], references: [id], onUpdate: Restrict, map: "fk_avaliacao_avaliador")
  finalizacao    conversa_finalizacao @relation(fields: [finalizacao_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_avaliacao_finalizacao")

  @@unique([finalizacao_id, avaliador_id], map: "uq_avaliacao_finalizacao_avaliador")
  @@index([avaliador_id], map: "idx_avaliacao_avaliador")
}

model conversa_finalizacao {
  id                 Int         @id @default(autoincrement())
  conversa_id        Int
  finalizada_por_id  Int
  ultima_mensagem_id Int?
  finalizada_em      DateTime    @default(now()) @db.DateTime(0)
  avaliacoes         avaliacao[]
  conversa           conversa    @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_finalizacao_conversa")
  finalizada_por     cadastro    @relation("ResponsavelFinalizacao", fields: [finalizada_por_id], references: [id], onUpdate: Restrict, map: "fk_finalizacao_responsavel")
  ultima_mensagem    mensagem?   @relation("MensagemFinalizacao", fields: [ultima_mensagem_id], references: [id], onUpdate: Restrict, map: "fk_finalizacao_ultima_mensagem")

  @@unique([conversa_id, ultima_mensagem_id], map: "uq_finalizacao_conversa_mensagem")
  @@index([finalizada_por_id], map: "idx_finalizacao_responsavel")
  @@index([ultima_mensagem_id], map: "idx_finalizacao_ultima_mensagem")
}

model conversa_transferencia {
  id                                                       Int        @id @default(autoincrement())
  conversa_id                                              Int
  setor_origem_id                                          Int
  setor_destino_id                                         Int
  transferida_por_id                                       Int
  motivo                                                   String     @db.VarChar(500)
  transferida_em                                           DateTime   @default(now()) @db.DateTime(0)
  conversa                                                 conversa   @relation(fields: [conversa_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_transferencia_conversa")
  cadastro                                                 cadastro   @relation(fields: [transferida_por_id], references: [id], onUpdate: Restrict, map: "fk_transferencia_responsavel")
  setores_conversa_transferencia_setor_destino_idTosetores setores    @relation("conversa_transferencia_setor_destino_idTosetores", fields: [setor_destino_id], references: [id], onUpdate: Restrict, map: "fk_transferencia_setor_destino")
  setores_conversa_transferencia_setor_origem_idTosetores  setores    @relation("conversa_transferencia_setor_origem_idTosetores", fields: [setor_origem_id], references: [id], onUpdate: Restrict, map: "fk_transferencia_setor_origem")
  mensagem                                                 mensagem[]

  @@index([conversa_id, transferida_em], map: "idx_transferencia_conversa_data")
  @@index([transferida_por_id], map: "idx_transferencia_responsavel")
  @@index([setor_destino_id, transferida_em], map: "idx_transferencia_setor_destino_data")
  @@index([setor_origem_id, transferida_em], map: "idx_transferencia_setor_origem_data")
}

model comunidade {
  id                        Int                         @id @default(autoincrement())
  nome_comunidade           String                      @db.VarChar(150)
  descricao_comunidade      String                      @db.VarChar(400)
  categorias                comunidade_categorias
  imagem_comunidade         String?                     @db.VarChar(500)
  ocultar_municipes         Boolean                     @default(false)
  conversa_id               Int?                        @unique(map: "uq_comunidade_conversa")
  comunidade_criada_em      DateTime                    @default(now()) @db.DateTime(0)
  comunidade_criador_id     Int?
  conversa                  conversa?                   @relation(fields: [conversa_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_comunidade_conversa")
  criador                   cadastro?                   @relation(fields: [comunidade_criador_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_comunidade_criador")
  comunidade_usuarios       comunidade_usuarios[]
  convite_comunidade        convite_comunidade[]
  promocoes_comunidades     promocoes_comunidades[]
  rebaixamentos_comunidades rebaixamentos_comunidades[]

  @@index([comunidade_criador_id], map: "comunidade_criador_id")
}

model convite_comunidade {
  id            Int        @id @default(autoincrement())
  token         String     @unique(map: "uq_convite_token") @db.VarChar(64)
  comunidade_id Int
  criado_por    Int
  expira_em     DateTime   @db.DateTime(0)
  usado         Boolean    @default(false)
  criado_em     DateTime   @default(now()) @db.DateTime(0)
  comunidade    comunidade @relation(fields: [comunidade_id], references: [id], onUpdate: Restrict, map: "fk_convite_comunidade")
  cadastro      cadastro   @relation(fields: [criado_por], references: [id], onUpdate: Restrict, map: "fk_convite_criador")

  @@index([comunidade_id], map: "idx_convite_comunidade")
  @@index([criado_por], map: "idx_convite_criador")
}

model comunidade_usuarios {
  id            Int                             @id @default(autoincrement())
  comunidade_id Int
  usuario_id    Int
  tipo_funcao   comunidade_usuarios_tipo_funcao @default(membro)
  comunidade    comunidade                      @relation(fields: [comunidade_id], references: [id], onUpdate: Restrict, map: "fk_cu_comunidade")
  cadastro      cadastro                        @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_cu_usuario")

  @@unique([comunidade_id, usuario_id], map: "uq_comunidade_usuario")
  @@index([usuario_id], map: "fk_cu_usuario")
}

model promocoes_comunidades {
  id                                                        Int        @id @default(autoincrement())
  promovido_por                                             Int
  pessoa_promovida                                          Int
  comunidade_id                                             Int
  promovido_em                                              DateTime   @db.DateTime(0)
  comunidade                                                comunidade @relation(fields: [comunidade_id], references: [id], onUpdate: Restrict, map: "fk_prom_com_comunidade")
  cadastro_promocoes_comunidades_pessoa_promovidaTocadastro cadastro   @relation("promocoes_comunidades_pessoa_promovidaTocadastro", fields: [pessoa_promovida], references: [id], onUpdate: Restrict, map: "fk_prom_com_pessoa_promovida")
  cadastro_promocoes_comunidades_promovido_porTocadastro    cadastro   @relation("promocoes_comunidades_promovido_porTocadastro", fields: [promovido_por], references: [id], onUpdate: Restrict, map: "fk_prom_com_promovido_por")

  @@index([comunidade_id], map: "fk_prom_com_comunidade")
  @@index([pessoa_promovida], map: "fk_prom_com_pessoa_promovida")
  @@index([promovido_por], map: "fk_prom_com_promovido_por")
}

model rebaixamentos_comunidades {
  id                                                            Int        @id @default(autoincrement())
  rebaixado_por                                                 Int
  pessoa_rebaixada                                              Int
  comunidade_id                                                 Int
